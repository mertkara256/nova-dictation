{
  "name": "nova-dictation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/start.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/end-to-end.ts",
    "scan:speech": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/speech-scan.ts",
    "whisper": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/whisper-server.ts",
    "shortcut": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/create-shortcut.ts",
    "bench": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/speech-benchmark.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
